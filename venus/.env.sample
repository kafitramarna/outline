# VenusVerse outline env — copy to .env (dev: fill with local values; prod: VPS).
# Full upstream reference: ../.env.sample. Only what we actually set is listed.

NODE_ENV=production
URL=https://wiki.129-225-0-136.nip.io
PORT=3000
WEB_CONCURRENCY=1
# NPM terminates TLS — outline must not try to enforce its own https redirect.
FORCE_HTTPS=false

SECRET_KEY=
UTILS_SECRET=

# --- data (compose service names on prod; localhost+offset ports on dev)
DATABASE_URL=postgres://outline:CHANGE_ME@postgres:5432/outline
REDIS_URL=redis://redis:6379

# --- storage
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# --- VenusVerse SSO (client "outline", confidential)
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=https://sso.129-225-0-136.nip.io/oauth/authorize
OIDC_TOKEN_URI=https://sso.129-225-0-136.nip.io/oauth/token
OIDC_USERINFO_URI=https://sso.129-225-0-136.nip.io/oauth/userinfo
OIDC_USERNAME_CLAIM=name
OIDC_DISPLAY_NAME=VenusVerse
OIDC_SCOPES=openid profile email

# --- smtp (optional: invites/notifications; mailpit in dev on :1028)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=wiki@example.com
